# Release credentials for scripts/release.sh. Copy to .env (gitignored) and fill in. Never commit .env.

# npm: a granular access token for the `automo` account, read and write on the `automo-build` package,
# with "bypass two-factor authentication" on. Create it at https://www.npmjs.com/settings/automo/tokens
NPM_TOKEN=

# MCP registry: the Ed25519 private key behind the TXT record on automo.build, as hex.
# From the PEM file:
#   openssl pkey -in <key.pem> -noout -text | sed -n '/priv:/,/pub:/p' | sed '1d;$d' | tr -d ' :\n'
MCP_PRIVATE_KEY=
